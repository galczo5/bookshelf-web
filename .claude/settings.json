{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx prettier --write src/ --log-level silent",
            "timeout": 30000
          },
          {
            "type": "command",
            "command": "npx eslint --fix src/ --quiet",
            "timeout": 30000
          },
          {
            "type": "command",
            "command": "npx tsc --noEmit",
            "timeout": 60000
          }
        ]
      }
    ]
  }
}
