{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "allowImportingTsExtensions": false,
    "module": "node16",
    "moduleResolution": "node16",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "incremental": false
  },
  "include": [
    "scripts/migrate.mts",
    "scripts/seed.mts",
    "scripts/seed-core.mts",
    "src/lib/db/migrations/**/*.mts"
  ],
  "exclude": ["node_modules", ".next"]
}
