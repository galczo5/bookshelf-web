# syntax=docker/dockerfile:1
# All-in-one image: bundles Next.js app + Postgres for handoff testing.
# Do NOT use for the App Runner production path — that uses Dockerfile.
ARG NODE_VERSION=22-alpine

# ── deps ────────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# ── builder ─────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ── runner ──────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
# Postgres data directory and app config live on a persistent volume at /data
ENV PGDATA=/data/pgdata
ENV BOOKSHELF_CONFIG_FILE=/data/config.env
ENV BOOKSHELF_RELOAD_SENTINEL=/data/reload
# DATABASE_URL is set dynamically by entrypoint.sh (points at localhost)

RUN apk add --no-cache postgresql postgresql-contrib tini su-exec openssl

# App user (matches non-root uid used by the standalone server)
RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 --ingroup nodejs --no-create-home nextjs

# Persistent volume mount point; subdirs are created by entrypoint.sh
RUN mkdir -p /data

# App runtime (standalone output)
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Compiled migration + seed scripts
COPY --from=builder --chown=nextjs:nodejs /app/dist ./dist

# kysely is not traced by Next.js standalone; copy manually (same as Dockerfile)
COPY --from=builder /app/node_modules/kysely ./node_modules/kysely

# Seed assets must live adjacent to dist/scripts/seed-core.mjs so that
# import.meta.dirname resolves SEED_DIR = dist/scripts/seed at runtime.
COPY --from=builder --chown=nextjs:nodejs /app/scripts/seed/books.json ./dist/scripts/seed/books.json
COPY --from=builder --chown=nextjs:nodejs /app/scripts/seed/covers ./dist/scripts/seed/covers

COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

VOLUME ["/data"]
EXPOSE 3000
ENTRYPOINT ["tini", "--", "/app/entrypoint.sh"]
