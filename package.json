{
  "name": "bookshelf",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:migrate",
    "build:migrate": "rm -rf dist && tsc -p tsconfig.migrate.json",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:migrate:down": "tsx scripts/migrate.mts down",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:migrate-replay": "tsx scripts/test-migrate-replay.mts",
    "prepare": "husky"
  },
  "dependencies": {
    "@tiptap/pm": "^2",
    "@tiptap/react": "^2",
    "@tiptap/starter-kit": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.8.0",
    "googleapis": "^144.0.0",
    "jszip": "^3.10.1",
    "kysely": "^0.29.2",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "openai": "^6.39.1",
    "pg": "^8.21.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.8.1",
    "tailwind-merge": "^3.6.0",
    "tiptap-markdown": "^0.8",
    "tw-animate-css": "^1.4.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,mjs,mts,json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
